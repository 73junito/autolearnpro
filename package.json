{
  "name": "autolearnpro",
  "version": "0.1.0",
  "private": true,
  "description": "AutoLearnPro clean unified architecture",
  "packageManager": "npm@10.9.8",
  "engines": {
    "node": ">=22.0.0 <23",
    "npm": ">=10.0.0 <11"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "validate:foundation": "node infrastructure/scripts/validate-foundation.mjs",
    "test:runtime": "node --test tests/runtime-health.test.mjs tests/role-approval-http.test.mjs tests/role-approval-rate-limit.test.mjs tests/academic-http.test.mjs tests/academic-failclosed.test.mjs tests/academic-executor-boundary.test.mjs tests/academic-error-progress-regression.test.mjs tests/env-isolation.test.mjs",
    "test:academic": "node --test tests/academic-http.test.mjs tests/academic-failclosed.test.mjs tests/academic-executor-boundary.test.mjs tests/academic-error-progress-regression.test.mjs",
    "test:academic:live": "node --test tests/academic-live.test.mjs",
    "test:academic:r1:live": "node infrastructure/scripts/run-r1-live.mjs",
    "test:approval:live": "node --test tests/role-approval-live.test.mjs tests/approval-shared-quota-live.test.mjs tests/role-session-revocation-live.test.mjs",
    "test": "npm run validate:foundation && npm run test:runtime",
    "lint:oxc": "oxlint apps/web/src infrastructure/scripts tests",
    "fmt:check": "oxfmt --check apps/web/src/academic.mjs apps/web/src/server.mjs infrastructure/scripts/check-integration-readiness.mjs infrastructure/scripts/run-r1-live.mjs",
    "fmt:academic": "oxfmt --write apps/web/src/academic.mjs apps/web/src/server.mjs"
  },
  "devDependencies": {
    "oxfmt": "0.76.0",
    "oxlint": "1.91.0"
  }
}
