{
  "name": "autolearnpro",
  "version": "0.1.0",
  "private": true,
  "description": "AutoLearnPro clean unified architecture",
  "packageManager": "npm@10.9.8",
  "engines": {
    "node": ">=22.12.0 <23",
    "npm": ">=10.0.0 <11"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "devDependencies": {
    "axe-core": "4.14.0",
    "oxfmt": "0.76.0",
    "oxlint": "1.91.0",
    "playwright-core": "1.64.1"
  },
  "scripts": {
    "validate:foundation": "node infrastructure/scripts/validate-foundation.mjs",
    "test:runtime": "node --test tests/runtime-health.test.mjs tests/role-approval-http.test.mjs tests/role-approval-rate-limit.test.mjs",
    "test:approval:live": "node --test tests/role-approval-live.test.mjs tests/approval-shared-quota-live.test.mjs tests/role-session-revocation-live.test.mjs",
    "test": "npm run validate:foundation && npm run test:runtime"
  }
}